<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" version="1.0" class="in-text" demote-non-dropping-particle="never" default-locale="pt-BR">
  <info>
    <title>Minimal Articles - Typst - ABNT (Português - Brasil)</title>
    <title-short>ABNT Typst 2025</title-short>
    <id>http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas-usp-fmvz</id>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas-usp-fmvz" rel="self"/>
    <link href="http://www.zotero.org/styles/associacao-brasileira-de-normas-tecnicas" rel="template"/>
    <author>
      <name>Maycon Fernandes Melo</name>
      <email>mayconfmelo.contato@gmail.com</email>
      <uri>https://www.github.com/mayconfmelo</uri>
    </author>
    <contributor>
      <name>Alberto Massao Kawai</name>
      <email>alberto.kawai@gmail.com</email>
      <uri>https://www.mendeley.com/profiles/alberto-kawai/</uri>
    </contributor>
    <category citation-format="author-date"/>
    <summary>The Brazilian Standard Style in accordance with ABNT-NBR 6023:2025 (adapted to Typst/Hayagriva)</summary>
    <updated>2022-04-05T16:21:57+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">This work is licensed under a Creative Commons Attribution-ShareAlike 3.0 License</rights>
  </info>
  <locale xml:lang="pt-BR">
    <terms>
      <term name="month-01" form="short">jan.</term>
      <term name="month-02" form="short">fev.</term>
      <term name="month-03" form="short">mar.</term>
      <term name="month-04" form="short">abr.</term>
      <term name="month-05" form="short">maio</term>
      <term name="month-06" form="short">jun.</term>
      <term name="month-07" form="short">jul.</term>
      <term name="month-08" form="short">ago.</term>
      <term name="month-09" form="short">set.</term>
      <term name="month-10" form="short">out.</term>
      <term name="month-11" form="short">nov.</term>
      <term name="month-12" form="short">dez.</term>
      <term name="editor" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="container-author" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
      <term name="collection-editor" form="short">
        <single>ed</single>
        <multiple>eds</multiple>
      </term>
    </terms>
  </locale>
  <!-- TODO: Optimize CSL macros -->
  <macro name="access">
    <text variable="URL" prefix="Disponível em: " suffix=". "/>
    <date variable="accessed" prefix="Acesso em: " suffix=". ">
      <date-part name="day" suffix=" "/>
      <date-part name="month" form="short" suffix=". " text-case="lowercase"/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="main-author">
    <names variable="author" font-variant="normal">
      <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
        <name-part name="family" text-case="uppercase"/>
        <name-part name="given" text-case="capitalize-first"/>
      </name>
      <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      <substitute>
        <names variable="editor"/>
        <names variable="translator"/>
        <text macro="title" text-case="uppercase"/>
      </substitute>
    </names>
  </macro>
  <macro name="author">
    <group delimiter="; ">
      <names variable="author" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
        <!--<substitute>
          <names variable="editor"/>
          <names variable="translator"/>
          <text macro="title" text-case="uppercase"/>
        </substitute>-->
      </names>
      <names variable="editor-translator" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      </names>
      <names variable="editor" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      </names>
      <names variable="contributor" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      </names>
      <names variable="organizer" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      </names>
      <names variable="illustrator" font-variant="normal">
        <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
          <name-part name="family" text-case="uppercase"/>
          <name-part name="given" text-case="capitalize-first"/>
        </name>
        <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
      </names>
    </group>
  </macro>
  <macro name="author-family">
     <names variable="author">
      <name form="short" name-as-sort-order="all" sort-separator=", " initialize-with=". " delimiter="; " delimiter-precedes-last="never">
        <name-part name="family" text-case="capitalize-first"/>
      </name>
      <et-al font-style="italic"/>
    </names>
  </macro>
  <macro name="citation-locator">
    <group>
      <label variable="locator" form="short"/>
      <text variable="locator" prefix=" "/>
    </group>
  </macro>
  <macro name="collection">
    <choose>
      <if variable="collection-title">
        <group delimiter=", " prefix="(" suffix="). ">
          <text variable="collection-title"/>
          <choose>
            <if variable="collection-number">
              <group>
                <text term="volume" form="short" suffix=". "/>
                <text variable="collection-number"/>
              </group>
            </if>
          </choose>
        </group>
      </if>
    </choose>
  </macro>
  <macro name="container">
    <choose>
      <if type="chapter">
        <names variable="container-author" delimiter=", ">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given" text-case="capitalize-first"/>
          </name>
          <substitute>
            <names variable="editor"/>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </if>
    </choose>
    <text variable="container-title"/>
  </macro>
  <macro name="container-contributors">
    <choose>
      <if type="chapter">
        <names variable="container-author" delimiter=", ">
          <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="always">
            <name-part name="family" text-case="uppercase"/>
            <name-part name="given" text-case="capitalize-first"/>
          </name>
          <substitute>
            <names variable="editor"/>
            <names variable="collection-editor"/>
          </substitute>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="container-title">
    <choose>
      <if type="paper-conference" match="any">
        <text variable="container-title" prefix=" " suffix=", "/>
      </if>
      <else>
        <text variable="container-title" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <macro name="edition">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="numeric" suffix=". "/>
          <text term="edition" form="short" suffix="."/>
        </group>
      </if>
      <else>
        <number variable="edition" suffix=". "/>
      </else>
    </choose>
  </macro>
  <macro name="event">
    <group delimiter=", ">
      <text variable="event-title" text-case="uppercase"/>
      <group delimiter=" ">
        <date variable="event-date">
          <date-part name="day"/>
          <date-part name="month" form="short"/>
          <date-part name="year"/>
        </date>
      </group>
      <text variable="event-place"/>
    </group>
  </macro>
  <macro name="event-old">
    <choose>
      <if variable="event-title">
        <choose>
          <if variable="genre" match="none">
            <text term="in" text-case="capitalize-first" suffix=": "/>
            <text variable="event" text-case="uppercase"/>
          </if>
          <else>
            <group delimiter=" ">
              <text variable="genre" text-case="capitalize-first"/>
              <text variable="event"/>
            </group>
          </else>
        </choose>
      </if>
    </choose>
  </macro>
  <macro name="issued">
    <choose>
      <if variable="issued" match="any">
        <group>
          <choose>
            <if type="book chapter" match="none">
              <date variable="issued">
                <date-part name="day" suffix=" "/>
                <date-part name="month" form="short" suffix=" "/>
              </date>
            </if>
          </choose>
          <date variable="issued">
            <date-part name="year"/>
          </date>
        </group>
      </if>
      <else>
        <text value="[s.d.] "/>
      </else>
    </choose>
  </macro>
  <macro name="issued-year">
    <choose>
      <if variable="issued" match="all">
        <date date-parts="year" form="numeric" variable="issued" prefix=" ">
          <date-part name="year"/>
        </date>
      </if>
      <else>
        <text value="[s.d.] "/>
      </else>
    </choose>
  </macro>
  <macro name="locators">
    <choose>
      <if match="any" type="article-journal article-magazine article-newspaper">
        <group delimiter=", ">
          <group delimiter=", ">
            <text variable="volume" prefix="v. "/>
            <text variable="issue" prefix="n. "/>
          </group>
          <text variable="page" prefix="p. "/>
        </group>
      </if>
      <else-if match="any" type="paper-conference">
        <group delimiter=", ">
          <group delimiter=", ">
            <text variable="volume" prefix="v. "/>
          </group>
          <text variable="page" prefix="p. " suffix=". "/>
        </group>
      </else-if>
      <else-if match="any" type="book">
        <group delimiter=", ">
          <group>
            <text variable="volume" prefix="v. " suffix=". "/>
            <text variable="number-of-pages" suffix=" p."/>
          </group>
        </group>
      </else-if>
      <else-if type="chapter" match="any">
        <text variable="page" prefix="p. "/>
      </else-if>
      <else-if type="thesis" match="any">
        <group>
          <group>
            <text variable="page" suffix=" f."/>
          </group>
        </group>
      </else-if>
    </choose>
  </macro>
  <macro name="note">
    <choose>
      <if variable="note" match="any">
        <text variable="note" suffix=". "/>
      </if>
    </choose>
  </macro>
  <macro name="publisher">
    <choose>
      <if match="any" variable="publisher">
        <choose>
          <if variable="publisher-place">
            <text variable="publisher-place" suffix=": "/>
          </if>
          <else-if type="entry-encyclopedia"/>
          <else>
            <text value="[s.l.] "/>
          </else>
        </choose>
        <choose>
          <if variable="publisher">
            <group delimiter=", ">
              <text variable="publisher"/>
              <choose>
                <if type="entry-encyclopedia">
                  <text macro="volume"/>
                </if>
              </choose>
              <text macro="issued"/>
            </group>
          </if>
          <else>
            <text value="[s.n.] "/>
          </else>
        </choose>
      </if>
      <else>
        <text value="[s.l: s.n.] "/>
      </else>
    </choose>
  </macro>
  <macro name="secondary-contributors">
    <choose>
      <if type="chapter" match="none">
        <names variable="editor" delimiter="; " prefix=" (" suffix=")">
          <name initialize-with=". " delimiter=", "/>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="serial-number">
    <group delimiter=", " suffix=". ">
      <text variable="DOI" prefix="DOI "/>
      <text variable="ISBN" prefix="ISBN "/>
      <text variable="ISSN" prefix="ISSN "/>
      <text variable="PMID" prefix="PMID "/>
      <text variable="PMCID" prefix="PMCID "/>
    </group>
  </macro>
  <macro name="title">
    <choose>
      <if type="chapter" match="any">
        <text variable="title"/>
      </if>
      <else-if type="book thesis" match="any">
        <text variable="title" font-weight="bold"/>
      </else-if>
      <else-if type="article-journal bill" match="any">
        <text variable="title" text-case="title" font-weight="normal"/>
      </else-if>
      <else-if type="article-newspaper article-magazine" match="any">
        <text variable="title" text-case="capitalize-first"/>
      </else-if>
      <else-if type="paper-conference" match="any">
        <text variable="title" suffix=". "/>
      </else-if>
      <else>
        <text variable="title" font-weight="bold"/>
      </else>
    </choose>
  </macro>
  <macro name="translator">
    <choose>
      <if variable="translator" match="any">
        <text value="Tradução: "/>
        <names variable="translator" delimiter="; ">
          <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
            <name-part name="given" text-case="capitalize-first"/>
            <name-part name="family" text-case="capitalize-first"/>
          </name>
        </names>
      </if>
    </choose>
  </macro>
  <macro name="volume">
    <group delimiter=" ">
      <text term="volume" form="short"/>
      <number variable="volume" form="numeric"/>
    </group>
  </macro>
  <citation et-al-min="4" et-al-use-first="1" collapse="year" disambiguate-add-year-suffix="true">
    <sort>
      <key macro="author"/>
      <key macro="issued-year"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=", ">
        <choose>
          <if variable="author">
            <text macro="author-family"/>
          </if>
          <else>
            <text variable="title-short"/>
          </else>
        </choose>
        <date date-parts="year" form="text" variable="issued"/>
        <text macro="citation-locator"/>
      </group>
    </layout>
  </citation>
  <bibliography>
    <sort>
      <key macro="main-author"/>
      <key variable="issued"/>
    </sort>
    <layout>
      <choose>
        <if type="book">
          <group>
            <choose>
              <if variable="event-title">
                <choose>
                  <if variable="author" match="none">
                    <text macro="event" suffix=". "/>
                    <text variable="title" suffix=". " font-weight="bold"/>
                  </if>
                  <else>
                    <text macro="author" suffix=". "/>
                    <text variable="title" suffix=". "/>
                  </else>
                </choose>
              </if>
              <else>
                <text macro="author" suffix=". "/>
                <text variable="title" suffix=". " font-weight="bold"/>
              </else>
            </choose>
            <group delimiter=" " suffix=". ">
              <text macro="edition"/>
              <text macro="volume"/>
            </group>
            <text macro="translator" suffix=". "/>
            <choose>
              <if variable="event-title author" match="all">
                <text term="in" text-case="capitalize-first" suffix=": "/>
                <text macro="event" suffix=". "/>
                <text variable="genre" suffix=". " font-weight="bold"/>
              </if>
            </choose>
            <text macro="publisher" suffix=". "/>
            <text variable="number-of-pages" suffix=" p. "/>
            <text macro="collection"/>
            <text variable="chapter-number" suffix=": "/>
            <text variable="page" prefix="p. " suffix=". "/>
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </if>
        <else-if type="thesis">
          <group>
            <group delimiter="; " suffix=". ">
              <names variable="author" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="family" text-case="uppercase"/>
                  <name-part name="given" text-case="capitalize-first"/>
                </name>
                <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              </names>
              <names variable="editor" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="family" text-case="uppercase"/>
                  <name-part name="given" text-case="capitalize-first"/>
                </name>
                <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              </names>
              <names variable="editor-translator" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="family" text-case="uppercase"/>
                  <name-part name="given" text-case="capitalize-first"/>
                </name>
                <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              </names>
              <names variable="contributor" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="family" text-case="uppercase"/>
                  <name-part name="given" text-case="capitalize-first"/>
                </name>
                <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              </names>
              <names variable="illustrator" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="family" text-case="uppercase"/>
                  <name-part name="given" text-case="capitalize-first"/>
                </name>
                <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              </names>
            </group>
            <text macro="title" suffix=". "/>
            <names variable="organizer" font-variant="normal" prefix="Orientador: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <text macro="translator" suffix=". "/>
            <group delimiter=", " suffix=". ">
              <text macro="issued"/>
              <text variable="page" prefix="p. "/>
            </group>
            <text variable="genre" suffix=" – "/>
            <group delimiter=", " suffix=". ">
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text variable="issued"/>
            </group>
            
            <!--<text macro="edition" suffix=". "/>-->
            <!--<text macro="publisher" suffix=". "/>-->
            <!--<text variable="number-of-pages" suffix=" p. "/>-->
            <!--<text macro="collection"/>-->
            <!--<text variable="chapter-number" text-case="capitalize-first" suffix=": "/>-->
            <!--<text variable="page" prefix="p. " suffix=". "/>-->
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="document">
          <group>
            <text macro="author" suffix=". "/>
            <text variable="authority" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text macro="volume" suffix=". "/>
            <text variable="genre" suffix=". "/>
            <text macro="translator" suffix=". "/>
            <choose>
              <if variable="publisher-place">
                <text macro="publisher" suffix=". "/>
              </if>
              <else>
                <text variable="publisher" suffix=": "/>
                <text macro="issued" suffix=". "/>
              </else>
            </choose>
            <group delimiter=" " suffix=". ">
              <text variable="volume" prefix="v. "/>
              <text variable="number-of-pages" suffix=" p"/>
            </group>
            <text macro="collection"/>
            <text variable="chapter-number" text-case="capitalize-first" suffix=": "/>
            <text variable="page" prefix="p. " suffix=". "/>
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="chapter post-weblog" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text variable="title" suffix=". "/>
            <choose>
              <if variable="container-title">
                <text term="in" text-case="capitalize-first" font-style="italic" suffix=": "/>
                <text macro="container-contributors" suffix=". "/>
                <text macro="container-title" suffix=". "/>
                <text macro="edition" suffix=". "/>
              </if>
            </choose>
            <text variable="collection-title" suffix=". "/>
            <text macro="translator" suffix=". "/>
            <text macro="publisher" suffix=". "/>
            <text variable="number-of-pages" suffix=" p. "/>
            <text macro="volume" suffix=". "/>
            <text macro="collection"/>
            <text variable="chapter-number" text-case="capitalize-first" suffix=": "/>
            <text variable="page" prefix="p. " suffix=". "/>
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="article article-newspaper article-magazine article-journal" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text variable="title" suffix=". "/>
            <text macro="container-title" suffix=", "/>
            <text variable="collection-title" suffix=". "/>
            <group delimiter=", " suffix=". ">
              <text variable="publisher-place"/>
              <text macro="edition"/>
              <text macro="volume"/>
              <text variable="issue" prefix="n. "/>
              <text variable="page" prefix="p. "/>
            </group>
            <text macro="issued" suffix=". "/>
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="entry">
          <choose>
            <if variable="author">
              <text macro="author" suffix=". "/>
              <text macro="title" suffix=". "/>
            </if>
            <else>
              <text variable="title" suffix=". "/>
            </else>
          </choose>
          <group delimiter=" " suffix=". ">
            <choose>
              <if variable="author">
                <text macro="edition"/>
                <text macro="volume"/>
                <text variable="issue" prefix="n. "/>
                <text variable="number"/>
              </if>
            </choose>
          </group>
          <text macro="container"/>
          <text macro="translator" suffix=". "/>
          <choose>
            <if variable="author">
              <text macro="publisher" suffix=". "/>
            </if>
            <else>
              <choose>
                <if variable="publisher-place">
                  <text variable="publisher-place" suffix=": "/>
                </if>
              </choose>
              <group delimiter=", " suffix=". ">
                <text variable="publisher"/>
                <text macro="volume"/>
                <text variable="number"/>
                <text variable="issue" prefix="n. "/>
              </group>
            </else>
          </choose>
          <text variable="number-of-pages" suffix=" p. "/>
          <text macro="collection"/>
          <text variable="page" prefix="p. " suffix=". "/>
          <text macro="serial-number"/>
          <text macro="note"/>
          <text macro="access"/>
        </else-if>
        <else-if type="paper-conference">
          <text macro="author" suffix=", "/>
          <text variable="container-title" suffix=". "/>
          <text variable="title" font-weight="bold" suffix=". "/>
          <text macro="publisher" suffix=". "/>
          <text macro="serial-number"/>
          <text macro="note"/>
          <text macro="access"/>
        </else-if>
        <else-if type="patent" match="any">
          <group delimiter="; " suffix=". ">
            <names variable="author" font-variant="normal">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
              <substitute>
                <names variable="editor"/>
                <names variable="translator"/>
                <text macro="title" text-case="uppercase"/>
              </substitute>
            </names>
            <names variable="editor-translator" font-variant="normal">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
            </names>
            <names variable="contributor" font-variant="normal">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
            </names>
            <names variable="organizer" font-variant="normal">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
            </names>
            <names variable="illustrator" font-variant="normal">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
            </names>
          </group>
          <text macro="title" suffix=". "/>
          <text variable="genre" suffix=". "/>
          <choose>
            <if variable="editor">
              <text value="Depositante: "/>
              <names variable="editor" font-variant="normal">
                <name font-style="normal" font-variant="normal" delimiter=", " delimiter-precedes-last="always" name-as-sort-order="all">
                  <name-part name="given" text-case="capitalize-first"/>
                  <name-part name="family" text-case="capitalize-first"/>
                </name>
              </names>
              <text value=". "/>
            </if>
          </choose>
          <text variable="number" suffix=". "/>
          <date variable="original-date" suffix=". ">
            <date-part name="day" prefix="Depósito: " suffix=" "/>
            <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
            <date-part name="year"/>
          </date>
          <date variable="issued" suffix=". ">
            <date-part name="day" prefix="Concessão: " suffix=" "/>
            <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
            <date-part name="year"/>
          </date>
          <text macro="note"/>
          <text macro="access"/>
        </else-if>
        <else-if type="legislation" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text variable="genre" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="container-title" suffix=", "/>
            <text macro="edition" suffix=", "/>
            <group delimiter=", " suffix=". ">
              <choose>
                <if variable="publisher">
                  <text macro="publisher"/>
                </if>
                <else>
                  <text variable="publisher-place"/>
                </else>
              </choose>
              <text variable="number"/>
              <text variable="volume" prefix="v. "/>
              <text variable="issue" prefix="n. "/>
              <text variable="page" prefix="p. "/>
              <choose>
                <if variable="publisher" match="none">
                  <date variable="issued" suffix=". ">
                    <date-part name="day" suffix=" "/>
                    <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
                    <date-part name="year"/>
                  </date>
                </if>
              </choose>
            </group>
            <text macro="note" suffix=". "/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="legal_case" match="any">
          <group>
            <names variable="author" font-variant="normal" suffix=". ">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="family" text-case="uppercase"/>
                <name-part name="given" text-case="capitalize-first"/>
              </name>
              <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
            </names>
            <names variable="editor" font-variant="normal" suffix=". ">
              <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <text variable="authority" suffix=". "/>
            <text variable="genre" suffix=". "/>
            <text macro="note" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="container-title" suffix=", "/>
            <text macro="edition" suffix=", "/>
            <group delimiter=", " suffix=". ">
              <choose>
                <if variable="publisher">
                  <text macro="publisher"/>
                </if>
                <else>
                  <text variable="publisher-place"/>
                </else>
              </choose>
              <text variable="number"/>
              <text variable="issue" prefix="n. "/>
              <text variable="page" prefix="p. "/>
              <choose>
                <if variable="publisher" match="none">
                  <date variable="issued" suffix=". ">
                    <date-part name="day" suffix=" "/>
                    <date-part name="month" form="short" suffix=" " text-case="lowercase"/>
                    <date-part name="year"/>
                  </date>
                </if>
              </choose>
            </group>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="motion_picture" match="any">
          <group>
            <text variable="title" suffix=". "/>
            <names variable="executive-producer" delimiter=", " prefix="Direção: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="producer" delimiter=", " prefix="Produção: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="script-writer" delimiter=", " prefix="Roteiro: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="performer" delimiter=", " prefix="Atuação: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="narrator" delimiter=", " prefix="Narração: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="composer" delimiter=", " prefix="Música: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <text macro="publisher" suffix=". "/>
            <text macro="note" suffix=". "/>
            <text macro="access" suffix=". "/>
          </group>
        </else-if>
        <else-if type="song" match="any">
          <group>
            <choose>
              <if variable="author">
                <names variable="author" font-variant="normal" suffix=". ">
                  <name font-style="normal" font-variant="normal" delimiter="; " delimiter-precedes-last="always" name-as-sort-order="all">
                    <name-part name="family" text-case="uppercase"/>
                    <name-part name="given" text-case="capitalize-first"/>
                  </name>
                  <label form="short" plural="never" text-case="lowercase" font-style="normal" prefix=" (" suffix=")"/>
                  <substitute>
                    <names variable="editor"/>
                    <names variable="translator"/>
                    <text macro="title" text-case="uppercase"/>
                  </substitute>
                </names>
                <text variable="title" suffix=". " font-weight="bold"/>
              </if>
              <else>
                <text variable="title" suffix=". "/>
              </else>
            </choose>
            <text variable="genre" suffix=". "/>
            <names variable="executive-producer" delimiter=", " prefix="Direção: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="producer" delimiter=", " prefix="Produção: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="composer" delimiter=", " prefix="Composição: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="script-writer" delimiter=", " prefix="Roteiro: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="performer" delimiter=", " prefix="Apresentação: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="contributor" delimiter=", " prefix="Convidado: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <names variable="narrator" delimiter=", " prefix="Narração: " suffix=". ">
              <name delimiter=", " sort-separator=" " delimiter-precedes-last="always">
                <name-part name="given" text-case="capitalize-first"/>
                <name-part name="family" text-case="capitalize-first"/>
              </name>
            </names>
            <text macro="publisher" suffix=". "/>
            <text macro="note" suffix=". "/>
            <text macro="access" suffix=". "/>
          </group>
        </else-if>
        <else-if type="broadcast event" match="any">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text variable="genre" suffix=". "/>
            <choose>
              <if variable="publisher">
                <text macro="publisher" suffix=". "/>
              </if>
              <else>
                <text macro="issued" suffix=". "/>
              </else>
            </choose>
            <text macro="note" suffix=". "/>
            <text macro="access" suffix=". "/>
          </group>
        </else-if>
        <else-if type="webpage">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text macro="serial-number" suffix=". "/>
            <text variable="genre" suffix=". "/>
            <text macro="publisher" suffix=". "/>
            <text macro="note" suffix=". "/>
            <text macro="access" suffix=". "/>
          </group>
        </else-if>
        
        <else-if type="entry-dictionary">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title"/>
            <text macro="container-contributors"/>
            <text macro="secondary-contributors"/>
            <text macro="container-title"/>
            <text variable="collection-title" prefix=": " suffix=". "/>
            <text macro="locators"/>
            <text macro="event"/>
            <text macro="publisher" prefix=". " suffix=". "/>
            <text variable="collection-title" prefix="(Texto para discussao, n. " suffix=")."/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="entry-encyclopedia">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="publisher"/>
            <text variable="issue" prefix="n. " suffix=". "/>
            <text macro="serial-number"/>
            <text macro="note"/>
            <text macro="access"/>
          </group>
        </else-if>
        <else-if type="manuscript">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=". "/>
            <text macro="edition" suffix=". "/>
            <text variable="publisher-place" suffix=", "/>
            <text macro="issued" suffix=". "/>
            <text macro="access" suffix=". "/>
            <text variable="archive" suffix=". "/>
          </group>
        </else-if>
        <else-if type="periodical">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title" suffix=", "/>
            <text macro="issued" suffix=". "/>
            <text variable="note" suffix=". "/>
          </group>
        </else-if>
        <else-if type="report">
          <group>
            <text macro="author" suffix=". "/>
            <text macro="title"/>
            <text macro="container-contributors"/>
            <text macro="secondary-contributors"/>
            <text macro="container-title"/>
            <text variable="collection-title" prefix=": "/>
            <text macro="locators"/>
            <text macro="event"/>
            <text macro="publisher" prefix=". " suffix=". "/>
            <text macro="access" suffix="."/>
          </group>
        </else-if>
        
        <else>
          <text macro="author" suffix=". "/>
          <text macro="title" suffix=". "/>
          <text macro="container" suffix=". "/>
          <text macro="translator" suffix=". "/>
          <choose>
            <if variable="publisher-place">
              <text variable="publisher-place" suffix=": "/>
            </if>
          </choose>
          <group delimiter=", " suffix=". ">
            <text variable="publisher"/>
            <text macro="edition"/>
            <text macro="volume"/>
            <choose>
              <if variable="title">
                <text variable="issue" prefix="n. "/>
                <text macro="issued"/>
              </if>
              <else>
                <text variable="issue"/>
              </else>
            </choose>
          </group>
          <text variable="number-of-pages" suffix=" p. "/>
          <text macro="collection"/>
          <text variable="page" prefix="p. " suffix=". "/>
          <text macro="note"/>
          <text macro="serial-number"/>
          <text macro="access"/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>